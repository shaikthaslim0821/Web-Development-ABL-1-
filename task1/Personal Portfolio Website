            <div class="card">
                <h3>Calculator</h3>
                <p>A simple calculator using
                   HTML, CSS and JavaScript.</p>
            </div>
        </div>
    </section>

    <!-- Achievements Section -->
    <section id="achievements">
        <h2>Achievements</h2>

        <div class="card-container">
            <div class="card">
                <h3>Certification</h3>
                <p>Add your course certificates here.</p>
            </div>

            <div class="card">
                <h3>Academic Achievement</h3>
                <p>Add your academic achievements here.</p>
            </div>
        </div>
    </section>

    <!-- Resume Section -->
    <section class="resume" id="resume">
        <h2>My Resume</h2>
        <p>Click below to download my resume.</p>
        <br>
        <a href="resume.pdf" download>
            Download Resume
        </a>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <h2>Contact Me</h2>

        <p>Email: yourname@gmail.com</p>
        <p>Phone: +91 XXXXXXXXXX</p>
        <p>Location: Your City, India</p>
        <p>LinkedIn: Add your LinkedIn profile</p>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 My Personal Portfolio.
           All Rights Reserved.</p>
    </footer>

    <script>
        function showMessage() {
            alert("Welcome to my personal portfolio!");
        }
    </script>

</body>
</html>
